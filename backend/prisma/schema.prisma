// Esquema inicial — mapea el modelo de datos del prototipo (index.html.html)
// a una base de datos compartida, con el PIN y el rol movidos al servidor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// String en vez de enum: así el esquema sigue funcionando igual si algún
// día se vuelve a probar en SQLite (que no soporta enums nativos).
// Valores válidos:
// Role: "RESIDENT" | "OPERATOR"
// EstadoPaquete: "PREALERTADO" | "EN_RECEPCION" | "PROGRAMADO" | "ENTREGADO"

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  nombre       String
  telefono     String
  torre        String?
  apto         String?
  // Constancia real de aceptación (fecha), no solo un checkbox de UI que
  // se puede saltar pegando directo contra la API — ver register().
  termsAcceptedAt DateTime
  createdAt    DateTime @default(now())

  packages     Package[]
  resetTokens  PasswordResetToken[]
  comentarios  Comentario[]
}

// Buzón de comentarios/inquietudes del residente hacia el operador —
// no está ligado a un paquete específico.
model Comentario {
  id          String   @id @default(cuid())
  residente   User     @relation(fields: [residenteId], references: [id])
  residenteId String
  mensaje     String
  createdAt   DateTime @default(now())
}

// El token crudo (alta entropía, de un solo uso) solo existe en el correo
// que se envía una vez; aquí se guarda su hash — si la tabla se filtra,
// no sirve para tomar la cuenta de nadie.
model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Package {
  id        String @id @default(cuid())
  residente User   @relation(fields: [residenteId], references: [id])
  residenteId String

  // datos del paquete
  proveedor                 String
  guia                      String  @default("Sin Guía")
  categoriaPeso             String  @default("ESTANDAR")
  costoServicio             Int     @default(4500)
  fotoUrl                   String?
  esContraEntregaProveedor  Boolean @default(false)
  valorProductoProveedor    Int     @default(0)
  // Distinto de valorProductoProveedor (eso es lo que se le paga al
  // transportista en un COD). Este es el valor que el residente declara
  // para efectos del tope de responsabilidad por custodia (ver Terms.jsx,
  // sección 4) — aplica exista o no cobro contra entrega.
  valorDeclarado            Int     @default(0)

  // datos de entrega
  estado              String @default("PREALERTADO")
  franjaHoraria        String?
  metodoPagoServicio   String?
  // Nota puntual de este paquete (ej. "pago con billete de $100.000,
  // llevar vueltos") — distinto del Comentario general, que no está
  // ligado a un paquete específico.
  notas                String?
  // Texto plano intencional (ver comentario en pin.service.js): la
  // protección real es que solo /packages/mine (dueño) y la creación
  // devuelven este campo; /packages (operador) lo excluye siempre.
  pin                  String
  fechaIngreso         DateTime      @default(now())
  fechaEntrega         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
