// Esquema inicial — mapea el modelo de datos del prototipo (index.html.html)
// a una base de datos compartida, con el PIN y el rol movidos al servidor.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// String en vez de enum: así el esquema sigue funcionando igual si algún
// día se vuelve a probar en SQLite (que no soporta enums nativos).
// Valores válidos:
// Role: "RESIDENT" | "OPERATOR"
// EstadoPaquete: "SIN_ASIGNAR" | "PREALERTADO" | "EN_RECEPCION" | "PROGRAMADO" | "ENTREGADO"
// (la máquina de estados vive en src/domain/paquete.machine.js)

// Tenant raíz del modelo multi-conjunto (KAN-8). Cada conjunto residencial
// (ej. Ipanema) tiene sus propios residentes, operador y paquetes, aislados
// de los demás. Aquí vive además la configuración que antes estaba fija en
// código: tarifas por categoría de peso (services/tariff.service.js) y datos
// de contacto/identidad del operador (frontend Terms.jsx).
// NOTA: Conjunto NO lleva conjuntoId (es la tabla raíz) y por eso queda
// fuera del filtro automático de tenant — ver design.md §1.5 y §2.3.
model Conjunto {
  id            String   @id @default(cuid())

  // Identidad
  nombre        String                  // "Conjunto Residencial Ipanema"
  slug          String   @unique         // "ipanema" — legible, para URLs/soporte

  // Código de invitación (design.md §3): token opaco embebido en el enlace/QR
  // de registro. invitacionActiva permite revocar/regenerar sin borrar histórico.
  codigoInvitacion String @unique
  invitacionActiva Boolean @default(true)

  // Configuración de contacto/identidad del operador (hoy fija en Terms.jsx)
  operadorNombre    String               // "Francisco Caro Yances"
  operadorWhatsapp  String               // E.164 sin '+', ej "573001112233" (para wa.me)
  operadorDomicilio String               // domicilio/dirección legal en Términos
  puntoRecepcion    String               // punto físico de recepción de paquetes

  // Tarifas por categoría de peso (hoy fijas en services/tariff.service.js).
  // Los defaults coinciden con la constante TARIFAS actual.
  tarifaMano     Int  @default(3000)      // MANO
  tarifaEstandar Int  @default(4500)      // ESTANDAR
  tarifaVolumen  Int  @default(7000)      // VOLUMEN
  tarifaPesado   Int  @default(12000)     // PESADO

  // Flag de bonos prepago por conjunto. false por defecto para todo conjunto
  // nuevo (restricción dura: BONOS_HABILITADOS apagado).
  bonosHabilitados Boolean @default(false)

  // Configuración de recepción/entrega (T2.1). Antes fija en el frontend.
  prefijoPais     String @default("57")   // prefijo telefónico para armar wa.me
  // Franjas de entrega: arreglo JSON de textos. null => el código aplica el
  // default (domain/conjuntoConfig.js, tomado de frontend/src/utils/schedule.js).
  franjasEntrega  Json?
  maxFotos        Int    @default(3)      // fotos máximas por paquete al recibir
  custodiaMaxDias Int    @default(30)     // días máximos que se custodia un paquete

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relaciones inversas hacia las tablas propias del conjunto (agregadas en A2).
  usuarios    User[]
  paquetes    Package[]
  bonos       Bono[]
  comentarios Comentario[]
  eventos     PaqueteEvento[]
  clavesIdempotencia ClaveIdempotencia[]
  paqueteFotos       PaqueteFoto[]
  cortesias          CortesiaApartamento[]
  domicilios         Domicilio[]
  usuariosConjunto   UsuarioConjunto[]
  domicilioEventos   DomicilioEvento[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         String
  nombre       String
  telefono     String
  torre        String?
  apto         String?
  // Constancia real de aceptación (fecha), no solo un checkbox de UI que
  // se puede saltar pegando directo contra la API — ver register().
  termsAcceptedAt DateTime
  createdAt    DateTime @default(now())

  // Conjunto de la cuenta. Obligatorio desde el CONTRACT (paso 4 del corte): NOT NULL +
  // FK RESTRICT, migración 20261028165010_contract_conjunto (ya aplicada en
  // producción; su SQL de origen está en prisma/manual/contract_conjunto_not_null.sql).
  // email se mantiene @unique GLOBAL, sin cambios (requirements, nota R5).
  // PLAN-conjunto S1.1: para un OPERATOR sigue siendo SU conjunto (aísla). Para un
  // RESIDENT la cuenta es de la persona y sirve en cualquier conjunto: aquí solo
  // queda el "último conjunto usado" (el que abre el contexto de sus requests hasta
  // que S1.3 lo resuelva por solicitud); NO aísla nada. `User` ya no está en
  // MODELOS_CON_TENANT: toda lectura/escritura pasa por services/usuario.service.js.
  conjunto     Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId   String

  packages     Package[]
  resetTokens  PasswordResetToken[]
  comentarios  Comentario[]
  bonos        Bono[]
  eventosActor PaqueteEvento[]
  clavesIdempotencia ClaveIdempotencia[]
  domicilios         Domicilio[]
  conjuntos          UsuarioConjunto[]
  domicilioEventos   DomicilioEvento[]

  // Indice de tenant (A3). El compuesto sirve tambien para las consultas que
  // filtran solo por conjuntoId (Postgres usa la primera columna), asi que no
  // se agrega un @@index([conjuntoId]) suelto. Acelera ademas
  // findMany({conjuntoId, role}) de checkin() y createPrealert() (design.md 1.2).
  @@index([conjuntoId, role])
}

// Lote de entregas prepago que un residente compra por adelantado con
// descuento (ej. 5 entregas Estándar por $18.000 en vez de $22.500). El
// operador decide cantidad y precio caso a caso — no hay tarifas fijas
// aquí. Cada bono queda amarrado a UNA categoría de peso: solo cubre
// paquetes de esa categoría (ver checkin() en packages.controller.js).
model Bono {
  id            String   @id @default(cuid())
  residente     User     @relation(fields: [residenteId], references: [id])
  residenteId   String
  // Tenant directo (denormalizado). Aunque el conjunto es derivable via
  // residenteId -> User.conjuntoId, la columna directa deja que la extension
  // de Prisma filtre de forma uniforme sin join (design.md 1.3). Obligatorio
  // desde el "contract".
  conjunto      Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId    String
  categoriaPeso String
  cantidadTotal Int
  cantidadUsada Int      @default(0)
  precioPagado  Int
  createdAt     DateTime @default(now())

  paquetes      Package[]

  @@index([conjuntoId])
}

// Buzón de comentarios/inquietudes del residente hacia el operador —
// no está ligado a un paquete específico.
model Comentario {
  id          String   @id @default(cuid())
  residente   User     @relation(fields: [residenteId], references: [id])
  residenteId String
  // Tenant directo (denormalizado), mismo criterio que Bono (design.md 1.3).
  conjunto    Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId  String
  mensaje     String
  createdAt   DateTime @default(now())

  @@index([conjuntoId])
}

// El token crudo (alta entropía, de un solo uso) solo existe en el correo
// que se envía una vez; aquí se guarda su hash — si la tabla se filtra,
// no sirve para tomar la cuenta de nadie.
// T3.2: el mismo modelo sirve al enlace de acceso (proposito ACCESO). Un token de
// un propósito NUNCA sirve para el otro: cada consulta filtra por `proposito`.
enum PropositoToken {
  RESET
  ACCESO
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id])
  userId    String
  tokenHash String
  proposito PropositoToken @default(RESET)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Package {
  id        String @id @default(cuid())
  // Opcional desde T2.1: un paquete recibido en portería SIN dueño conocido
  // (estado SIN_ASIGNAR) aún no tiene residente. onDelete Restrict explícito
  // para conservar la FK original (Prisma pondría SET NULL al volverla opcional).
  residente User?  @relation(fields: [residenteId], references: [id], onDelete: Restrict)
  residenteId String?

  // Tenant (KAN-8). Obligatorio desde el "contract" (design.md 5.2).
  conjunto  Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId String

  // Dirección de entrega a la que va el paquete (PLAN-conjunto S1.1). Opcional:
  // los SIN_ASIGNAR no tienen. `residenteId` se conserva como "quién lo pidió / a quién
  // va". RESTRICT: un Domicilio con paquetes no se borra.
  domicilio   Domicilio? @relation(fields: [domicilioId], references: [id], onDelete: Restrict)
  domicilioId String?

  // datos del paquete
  // proveedor = tienda/plataforma que vende (Amazon, Mercado Libre); es la
  // pre-alerta del residente y sigue siendo obligatorio. La empresa que
  // TRANSPORTA (Servientrega, Rappi...) es otra cosa: ver transportadora.
  proveedor                 String
  // `guia` YA existía (T2.1 la reutiliza, no la duplica): NOT NULL con default
  // "Sin Guía". La búsqueda de pre-alertas por guía usa el índice [conjuntoId, guia].
  guia                      String  @default("Sin Guía")
  // Texto que el operador escribe en la etiqueta cuando no hay residente
  // asignado (recepción sin pre-alerta, estado SIN_ASIGNAR).
  etiquetaNombre            String?
  transportadora            String?
  // Código que algunas plataformas (ej. Mercado Libre) generan para que
  // SU transportadora confirme la entrega — lo declara el residente para
  // que el operador lo tenga a mano cuando ese mensajero llegue a recepción.
  // No tiene relación con el pin (ese es el nuestro, para la entrega en puerta).
  pinProveedor               String?
  categoriaPeso             String  @default("ESTANDAR")
  costoServicio             Int     @default(4500)
  fotoUrl                   String?
  esContraEntregaProveedor  Boolean @default(false)
  valorProductoProveedor    Int     @default(0)
  // Distinto de valorProductoProveedor (eso es lo que se le paga al
  // transportista en un COD). Este es el valor que el residente declara
  // para efectos del tope de responsabilidad por custodia (ver Terms.jsx,
  // sección 4) — aplica exista o no cobro contra entrega.
  valorDeclarado            Int     @default(0)

  // datos de entrega
  estado              String @default("PREALERTADO")
  franjaHoraria        String?
  metodoPagoServicio   String?
  // Preferencia del residente al pedir la entrega (T2.8): "DOMICILIO" (por defecto
  // al programar) o "RECOGER" (lo recoge en portería). Texto validado en
  // el controlador (packages.controller.js), no enum de BD. Null = aún no eligió.
  modalidadEntrega     String?
  // Cómo se pagó REALMENTE el servicio al entregar: "EFECTIVO" | "TRANSFERENCIA"
  // (validado en domain/pago.js, no enum de BD). Distinto de metodoPagoServicio,
  // que es la preferencia de texto libre del residente al programar.
  metodoPago           String?
  // Nota puntual de este paquete (ej. "pago con billete de $100.000,
  // llevar vueltos") — distinto del Comentario general, que no está
  // ligado a un paquete específico.
  notas                String?
  // Texto plano intencional (ver comentario en pin.service.js): la
  // protección real es que solo /packages/mine (dueño) y la creación
  // devuelven este campo; /packages (operador) lo excluye siempre.
  pin                  String
  // Límite de intentos del PIN (T1.4): fallos acumulados y, al llegar a 5,
  // bloqueo temporal de la entrega hasta esta fecha.
  intentosPin          Int           @default(0)
  pinBloqueadoHasta    DateTime?
  fechaIngreso         DateTime      @default(now())
  // Cuándo el operador recibió físicamente el paquete (fechaIngreso es la
  // creación del registro, que en una pre-alerta es anterior a la llegada).
  recibidoEn           DateTime?
  // fechaEntrega YA existe y se escribe en ENTREGAR: T2.1 la reutiliza como
  // "entregadoEn" (no se agrega columna duplicada).
  fechaEntrega         DateTime?

  // Si este paquete se cobró $0 porque se descontó de un bono prepago
  // (ver checkin()), queda amarrado aquí para trazabilidad — distinto de
  // la cortesía de primera entrega, que no consume ningún bono.
  bono                 Bono?         @relation(fields: [bonoId], references: [id])
  bonoId               String?

  eventos              PaqueteEvento[]
  clavesIdempotencia   ClaveIdempotencia[]
  fotos                PaqueteFoto[]
  cortesia             CortesiaApartamento?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indice de tenant (A3). El compuesto cubre tambien el filtro solo por
  // conjuntoId (primera columna), asi que no se agrega un @@index([conjuntoId])
  // suelto. Acelera los listados por estado dentro de un conjunto (design.md 1.2).
  @@index([conjuntoId, estado])
  // Búsqueda de pre-alertas abiertas por guía dentro del conjunto (T2.3).
  @@index([conjuntoId, guia])
  // Paquetes de un residente por estado: listMine, /api/p/paquetes (sondeo cada 20 s),
  // schedule y la cuenta de pendientes (M5, revisión final T8.1).
  @@index([conjuntoId, residenteId, estado])
  // Paquetes de un Domicilio (cortesía por apartamento, lote de entrega, ficha del operador).
  @@index([conjuntoId, domicilioId])
}

// Bitácora auditable de cambios de estado del paquete (T1.3). SOLO INSERCIÓN:
// la migración instala un trigger Postgres que rechaza UPDATE y DELETE, y el
// código no expone ninguna de las dos operaciones (se escribe únicamente desde
// services/paquete.service.js#aplicarEvento, dentro de la misma transacción que
// cambia el estado). Lleva tenant (conjuntoId) y está en MODELOS_CON_TENANT.
model PaqueteEvento {
  id         String   @id @default(cuid())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId String
  paquete    Package  @relation(fields: [paqueteId], references: [id])
  paqueteId  String
  tipo       String   // evento de la máquina: PREALERTAR | RECIBIR | PROGRAMAR | ENTREGAR ...
  deEstado   String?  // null = el paquete aún no existía
  aEstado    String
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId    String?
  datos      Json?
  creadoEn   DateTime @default(now())

  @@index([conjuntoId, paqueteId, creadoEn])
}

// Resultado guardado de una recepción con cabecera `Idempotency-Key` (T2.3):
// un reintento con la misma clave (mismo operador y conjunto, ventana de 24 h)
// devuelve el mismo paquete sin crear otro. Se escribe en la MISMA transacción
// que crea el paquete. Lleva tenant (conjuntoId) y está en MODELOS_CON_TENANT.
// onDelete Cascade: borrar el paquete u operador no debe quedar bloqueado por
// una clave de reintento (es un dato desechable, no una bitácora).
model ClaveIdempotencia {
  id         String   @id @default(cuid())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId String
  clave      String
  operador   User     @relation(fields: [operadorId], references: [id], onDelete: Cascade)
  operadorId String
  paquete    Package  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  paqueteId  String
  creadoEn   DateTime @default(now())

  @@unique([conjuntoId, operadorId, clave])
  @@index([conjuntoId, creadoEn])
}

// Foto de un paquete guardada en el almacén externo (T5.1, bucket S3 de Railway).
// `clave` es la ruta del objeto en el almacén, nunca la imagen. Las fotos
// anteriores a T5.1 siguen en Package.fotoUrl (base64) y se leen como "legado".
// onDelete Cascade: borrar el paquete borra las filas (los objetos del bucket
// los limpia el almacén, mejor esfuerzo).
model PaqueteFoto {
  id         String   @id @default(cuid())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId String
  paquete    Package  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  paqueteId  String
  clave      String
  tipo       String
  orden      Int      @default(0)
  creadoEn   DateTime @default(now())

  @@index([conjuntoId, paqueteId, orden])
}

// Reserva de la cortesía de primera entrega por APARTAMENTO (revisión F2).
// Insertar la fila ES la reserva: el índice único [conjuntoId, claveApto] hace que
// dos recepciones paralelas del mismo apartamento nuevo no puedan llevarse ambas la
// cortesía (la perdedora espera a la ganadora y, al ver el conflicto, cobra TARIFA).
// `claveApto` es la clave normalizada de services/apartamento.service.js
// (torre canónica|apto; "cuenta:<id>" si torre/apto están incompletos).
// `paqueteId` es único: un paquete ocupa a lo sumo una cortesía. onDelete Cascade:
// si el paquete se borra, el apartamento queda libre. Lleva tenant (MODELOS_CON_TENANT).
model CortesiaApartamento {
  id         String   @id @default(cuid())
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId String
  claveApto  String
  paquete    Package  @relation(fields: [paqueteId], references: [id], onDelete: Cascade)
  paqueteId  String   @unique
  creadoEn   DateTime @default(now())

  @@unique([conjuntoId, claveApto])
}

// Dirección de entrega de una persona EN un conjunto (PLAN-conjunto S1.1): conjunto +
// torre + apto + quién recibe + teléfono. La cuenta (User) es de la persona y sirve en
// cualquier conjunto; el Domicilio es lo que pertenece a un conjunto, por eso lleva
// `conjuntoId` y está en MODELOS_CON_TENANT: el operador de un conjunto solo lee los
// del suyo, y de la persona solo ve lo que hay aquí (nunca email ni otros conjuntos).
//
// FORMA CANÓNICA (services/domicilio.service.js#canonicalizarDireccion), para que el
// índice único deduplique de verdad y no haya NULL (Postgres trata los NULL como
// distintos en un único):
//   torre = tokenTorre(torre) ?? ''   "TORRE 2" | "Torre 2" | "T2" | "2" -> "2"; "Torre A" -> "A"; sin torre -> ''
//   apto  = solo dígitos ?? ''        "Apto 302" -> "302"; sin apto -> ''
// `ultimoUsoEn` ordena "la última usada" (la que viene puesta en cada solicitud).
// `activo=false` la oculta de las propias listas sin perder el historial.
// onDelete RESTRICT en el usuario: un Domicilio nunca se borra en cascada.
model Domicilio {
  id           String   @id @default(cuid())
  conjunto     Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId   String
  usuario      User     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  usuarioId    String
  torre        String   @default("")
  apto         String   @default("")
  nombreRecibe String
  telefono     String
  ultimoUsoEn  DateTime @default(now())
  activo       Boolean  @default(true)
  creadoEn     DateTime @default(now())
  // `nombreRecibe` sin tildes y en minúsculas (domain/apartamento.js#sinTildes), para que el
  // operador busque por nombre EN LA BASE (`contains`) sin la extensión `unaccent` ni SQL
  // crudo. Lo escribe services/domicilio.service.js en cada alta/cambio de nombre; la
  // migración add_domicilio_busqueda_evento lo rellena para las filas existentes.
  nombreBusqueda String  @default("")

  paquetes Package[]
  eventos  DomicilioEvento[]

  @@unique([conjuntoId, usuarioId, torre, apto])
  // Búsqueda del operador por apartamento dentro de su conjunto.
  @@index([conjuntoId, apto])
}

// Bitácora de cambios sobre una dirección de entrega (revisión S3.2): `DESACTIVAR` y `REACTIVAR`
// (el operador desactiva un domicilio impostor o equivocado, o lo reactiva si fue un error). Lleva tenant. No tiene trigger
// de solo inserción (la app nunca la actualiza ni borra); `actorId` queda NULL si se borra
// la cuenta del operador.
model DomicilioEvento {
  id          String    @id @default(cuid())
  conjunto    Conjunto  @relation(fields: [conjuntoId], references: [id])
  conjuntoId  String
  domicilio   Domicilio @relation(fields: [domicilioId], references: [id], onDelete: Cascade)
  domicilioId String
  tipo        String    // DESACTIVAR | REACTIVAR
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorId     String?
  datos       Json?
  creadoEn    DateTime  @default(now())

  @@index([conjuntoId, domicilioId, creadoEn])
}

// Índice "en qué conjuntos tiene domicilio esta persona" (PLAN-conjunto S1.2). Es la
// vía segura para "Mis paquetes" multi-conjunto: Domicilio está bajo tenant y no se
// puede barrer entre conjuntos, así que se lee ESTA tabla (sin datos personales: solo
// dos ids) y luego se consulta cada conjunto dentro de su propio runWithTenant.
// NO lleva tenant a propósito (como Conjunto): la lee únicamente
// services/domicilio.service.js (la auditoría lo vigila) y siempre por usuarioId de la
// sesión; el operador nunca la consulta. Se escribe en crearOReutilizarDomicilio()
// ANTES de crear el Domicilio (un índice de más es inofensivo: devuelve un conjunto sin paquetes).
model UsuarioConjunto {
  usuario    User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId  String
  conjunto   Conjunto @relation(fields: [conjuntoId], references: [id])
  conjuntoId String
  creadoEn   DateTime @default(now())

  @@id([usuarioId, conjuntoId])
}
