DATABASE_URL="postgresql://user:password@localhost:5432/entrega_vecina"
JWT_SECRET="replace-with-a-long-random-value"
JWT_EXPIRES_IN="8h"
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Usados solo por prisma/seed.js para crear la única cuenta de operador.
# El registro público (/api/auth/register) nunca puede crear este rol.
OPERATOR_EMAIL="operador@entregavecina.local"
OPERATOR_PASSWORD="cambia-esta-clave"
OPERATOR_NOMBRE="Operador"
OPERATOR_TELEFONO="3000000000"
