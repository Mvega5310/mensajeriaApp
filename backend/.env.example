# Copia este archivo a backend/.env para desarrollo local.
# Al arrancar, el servidor valida estas variables (src/config/env.js): si falta
# una obligatoria o es inválida, NO arranca y lista todos los problemas a la vez.

# --- Obligatorias -----------------------------------------------------------

# Base de datos Postgres. La app funciona solo con Postgres (también en local).
DATABASE_URL="postgresql://user:password@localhost:5432/puertaya"

# Clave con la que se firman las sesiones (JWT). En producción debe tener al
# menos 32 caracteres aleatorios. Generar una:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-value"

# --- Opcionales con valor por defecto ---------------------------------------

# Duración de la sesión. Por defecto 8h.
JWT_EXPIRES_IN="8h"

# Puerto del servidor. Por defecto 4000. Railway inyecta el suyo; no hace falta.
PORT=4000

# Entorno: "production" activa las validaciones estrictas (p. ej. largo de JWT_SECRET).
# En local se deja sin definir o con "development".
# NODE_ENV=development

# --- Opcionales con aviso en el log si faltan --------------------------------

# Origen permitido para CORS: la URL del frontend, sin barra final.
# Si falta, la API acepta peticiones desde cualquier origen (se avisa al arrancar).
CORS_ORIGIN="http://localhost:5173"

# URL del frontend. Se usa para armar los enlaces de los correos
# (registro con código de invitación, restablecer contraseña).
FRONTEND_URL="http://localhost:5173"

# Correo transaccional (Resend: https://resend.com). Sin clave, el correo se
# simula y no se envía nada (se avisa al arrancar).
# onboarding@resend.dev funciona sin verificar dominio, pero SOLO envía al
# correo con el que creaste la cuenta de Resend. Para mandar a residentes
# reales hay que verificar un dominio propio en el dashboard de Resend y
# usar un remitente de ese dominio en EMAIL_FROM.
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="Puertaya Ipanema <onboarding@resend.dev>"

# Almacén de fotos (T5.1): bucket compatible con S3 (Railway Buckets). Las cuatro
# primeras van juntas o ninguna. Sin ellas: almacén en memoria en desarrollo (las
# fotos se pierden al reiniciar) y, en producción, las fotos siguen en la base
# como base64 con un aviso fuerte en el log. Cómo crear el Bucket: DEPLOY.md.
# FOTOS_S3_ENDPOINT="https://t3.storageapi.dev"
# FOTOS_S3_BUCKET="nombre-del-bucket"
# FOTOS_S3_ACCESS_KEY="..."
# FOTOS_S3_SECRET="..."
# FOTOS_S3_REGION="auto"
# FOTOS_S3_FORCE_PATH_STYLE="true"

# --- Solo para scripts (no las lee el servidor al arrancar) ------------------

# Usadas por prisma/seed.js para crear la única cuenta de operador de desarrollo.
# El registro público (/api/auth/register) nunca puede crear este rol.
OPERATOR_EMAIL="operador@puertaya-ipanema.local"
OPERATOR_PASSWORD="cambia-esta-clave"
OPERATOR_NOMBRE="Operador"
OPERATOR_TELEFONO="3000000000"

# Seed multi-conjunto (KAN-8). El seed crea/reutiliza un Conjunto local e
# imprime su código de invitación y el enlace de registro. Todas opcionales:
SEED_CONJUNTO_SLUG="local"
SEED_CONJUNTO_NOMBRE="Conjunto Local (desarrollo)"
SEED_OPERADOR_WHATSAPP="573000000000"
SEED_OPERADOR_DOMICILIO="Domicilio de desarrollo"
SEED_PUNTO_RECEPCION="Recepción"
